# =================================================================
# SkillBridge AI - Environment Variables
# =================================================================
# Copy this file to .env and fill in your values.
# For Vercel deployment, add all of these in your Vercel dashboard
# under Settings > Environment Variables.
# =================================================================

# ------------------------------------------------------------------
# BACKEND SECRETS (Server-side only, NEVER expose to browser)
# ------------------------------------------------------------------

# Google Gemini API Key (required for AI features)
GEMINI_API_KEY="your-gemini-api-key"

# JWT Secret (required for auth token signing - use a strong random string)
JWT_SECRET="your-super-secure-jwt-secret-min-32-chars"

# MongoDB Atlas Connection String (required for MongoDB features)
MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/skillbridge?retryWrites=true&w=majority"

# Comma-separated list of allowed CORS origins (optional, for custom domains)
ALLOWED_ORIGINS="https://your-app.vercel.app,https://your-custom-domain.com"

# Node environment
NODE_ENV="production"

# ------------------------------------------------------------------
# FIREBASE CLIENT CONFIG (Exposed via Vite VITE_ prefix to browser)
# ------------------------------------------------------------------

VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"

# Optional: Custom Firestore database ID (leave blank for default)
VITE_FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------
# OPTIONAL FRONTEND CONFIG
# ------------------------------------------------------------------

# API URL override (leave blank on Vercel - routes are relative /api/*)
# Only set this for a separate backend deployment or local dev override
VITE_API_URL=""

# App URL (used for callbacks, links, SEO)
APP_URL="https://your-app.vercel.app"
